		{"id":"d04","fromNode":"derror","fromSide":"right","toNode":"dsend","toSide":"bottom","color":"4","label":"dev_ws_reconectado()\n[backoff exp. 1-2-4-8-16s, intento<5]"},
		{"id":"d05","fromNode":"derror","fromSide":"bottom","toNode":"dplay","toSide":"left","color":"2","label":"dev_reintentos_agotados()\n[2 requests fallidos, WS vivo → clip local \"error_conexion\"]"},
		{"id":"d06","fromNode":"derror","fromSide":"right","toNode":"dplay","toSide":"top","color":"1","label":"dev_ws_reintentos_agotados()\n[5 reconexiones fallidas → clip local \"error_wifi\"]"},
		{"id":"d07","fromNode":"dplay","fromSide":"right","toNode":"dwake","toSide":"left","color":"4","label":"dev_msg_local_fin()\n[clip local terminó, decide el ESP32]"},
