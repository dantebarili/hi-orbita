		{"id":"m05","fromNode":"send","fromSide":"top","toNode":"send","toSide":"right","color":"2","label":"dev_wake_word_durante_envio()\n/ dev_push_flag_urgente(pausa_resumen)"},
		{"id":"m06","fromNode":"send","fromSide":"right","toNode":"back","toSide":"left","color":"5","label":"dev_fin_segmento()"},
