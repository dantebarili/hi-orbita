		{"id":"d01","fromNode":"dback","fromSide":"top","toNode":"derror","toSide":"top","color":"1","label":"dev_timeout_respuesta()\n[5s, WS vivo]"},
		{"id":"d02","fromNode":"dback","fromSide":"bottom","toNode":"derror","toSide":"bottom","color":"1","label":"dev_ws_desconectado()\n[heartbeat sin pong]"},
