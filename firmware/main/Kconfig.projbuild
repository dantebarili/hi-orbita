menu "Orbita integration"
    choice ORBITA_LAB_MODE
        prompt "Modo del firmware"
        default ORBITA_LAB_WEBSOCKET
        config ORBITA_LAB_UART
            bool "Captura por UART a WAV (estudio de audio del frente Audio)"
        config ORBITA_LAB_WEBSOCKET
            bool "Prototipo: audio continuo por WebSocket y parlante"
            select ESP_WS_CLIENT_SEPARATE_TX_LOCK
    endchoice

    config ORBITA_PLAYBACK_LOCAL_TEST
        bool "Diagnostico: solo tono local del parlante (sin captura ni red)"
        default n
        depends on ORBITA_LAB_WEBSOCKET
        help
            Repite un tono de 1 s con 3 s de silencio. No inicia mics, AFE ni red.
            Desactivar para volver al prototipo; no cambia credenciales ni pines.

    config ORBITA_WS_NO_CAPTURE_TEST
        bool "Diagnostico: WebSocket y parlante SIN microfonos"
        default n
        depends on ORBITA_LAB_WEBSOCKET && !ORBITA_PLAYBACK_LOCAL_TEST
        help
            No inicializa I2S de entrada, pipeline/AFE ni sink. Mantiene red y playback.
            Usar servidor con --downlink-tones-only. El tono local de arranque se conserva.

    config ORBITA_MIC_PLAYBACK_TEST
        bool "Diagnostico: microfonos y pitidos locales SIN red"
        default n
        depends on ORBITA_LAB_WEBSOCKET && !ORBITA_PLAYBACK_LOCAL_TEST && !ORBITA_WS_NO_CAPTURE_TEST
        help
            Captura cruda continua en un buffer reutilizado; se mide y descarta.
            Tres pitidos locales cada 5 s. No inicia Wi-Fi, WebSocket, pipeline ni AFE.

    config ORBITA_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        depends on ORBITA_LAB_WEBSOCKET
    config ORBITA_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        depends on ORBITA_LAB_WEBSOCKET
        help
            Credenciales locales: sdkconfig y firmware las contienen. No compartirlos.
    config ORBITA_WS_URI
        string "WebSocket URI (ws://IP-PC:8765/)"
        default ""
        depends on ORBITA_LAB_WEBSOCKET
    config ORBITA_WS_CAPTURE_SECONDS
        int "Segundos nominales por toma"
        range 1 600
        default 60
        depends on ORBITA_LAB_WEBSOCKET
        help
            Se termina con el primer mensaje completo que alcance esta cantidad
            de muestras. Puede sumar hasta 127.94 ms. Sin VAD como compuerta.
endmenu
